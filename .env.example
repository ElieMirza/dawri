# DAWRI Environment Variables
# Copy this file to .env and fill in values

# API-Sports Basketball (required for data:refresh)
# Get your key at: https://api-sports.io/
# Free tier: 100 requests/day, ~10/min
# IMPORTANT: Never expose this key in client code!
API_SPORTS_KEY=

# TheSportsDB (optional - free key works)
# Free key: 123
# Or register at: https://www.thesportsdb.com/
THESPORTSDB_KEY=123
